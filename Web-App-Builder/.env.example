# ============================================================
# Quantora Environment Configuration
# Copy this file to .env.local and fill in your values
# ============================================================

# Server Configuration
NODE_ENV=development
PORT=5000

# ============================================================
# Database Configuration
# ============================================================
# PostgreSQL is OPTIONAL - app works without it (in-memory mode)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/quantora
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================
# Session & Security
# ============================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secure-random-secret-here-min-32-chars

# CORS Configuration
CORS_ORIGIN=http://localhost:5000,http://localhost:5173,http://localhost:3000

# ============================================================
# AI Features (Optional)
# ============================================================
# Get your API key from https://platform.openai.com
OPENAI_API_KEY=sk-your-api-key-here
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-api-key-here
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# Replit Integration (Optional)
# ============================================================
# Only set if deploying on Replit
REPL_ID=

# ============================================================
# Logging & Monitoring
# ============================================================
LOG_LEVEL=info
DEBUG=false

# ============================================================
# Feature Flags
# ============================================================
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_ERROR_TRACKING=true
ENABLE_PERFORMANCE_MONITORING=true
